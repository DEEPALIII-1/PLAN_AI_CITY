# Plan AI City Configuration
PROJECT_NAME="Plan AI City"
VERSION="1.0.0"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./backend/plan_ai_city.db"
# Or PostgreSQL with PostGIS & pgvector:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/plan_ai_city"
USE_POSTGIS=false
USE_PGVECTOR=false

# Security & Authentication
SECRET_KEY="plan-ai-city-super-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & LLM Provider Configuration
LLM_PROVIDER="GEMINI" # Options: GEMINI, OPENAI, GROQ, OLLAMA, MOCK
DEFAULT_LLM_MODEL="gemini-1.5-flash"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
